---
import Base from '../layouts/Base.astro';
import { empresa } from '../data/empresa';

const pasos = [
  {
    titulo: 'Elegís y armás tu carrito',
    texto:
      'Buscá y compará productos de distintos Comercios afiliados. Un mismo carrito puede incluir productos de varios Comercios.',
  },
  {
    titulo: 'Confirmás con el total a la vista',
    texto:
      'Antes de confirmar ves el precio, el costo de envío y el tiempo estimado de entrega. Nada aparece después.',
  },
  {
    titulo: 'Pagás con Urbby Pay',
    texto:
      'Con tarjeta, procesada por Banco Agrícola. Según el Comercio y la zona, también podés pagar contra entrega.',
  },
  {
    titulo: 'Xpress te lo lleva',
    texto:
      'El Comercio prepara el pedido, Xpress lo recolecta y lo entrega en la dirección que indicaste, con cobertura nacional.',
  },
];

const envios = [
  {
    titulo: '24 horas hábiles',
    texto:
      'Plazo estándar desde el día hábil siguiente a la recolección. Lo recolectado antes de las 2:00 p.m. entra en la ventana de ese mismo día hábil. Por fuerza mayor puede extenderse hasta 48 horas hábiles.',
  },
  {
    titulo: 'Tres intentos de entrega',
    texto:
      'Xpress intenta entregar hasta tres veces en la dirección que indicaste. Las redirecciones de dirección no tienen costo adicional. Agotados los tres intentos, el pedido vuelve al Comercio.',
  },
  {
    titulo: 'Seguro de hasta USD $100',
    texto:
      'Por guía, o el valor declarado en factura si es menor, por daños comprobados de mala manipulación en el transporte. El reclamo se reporta por escrito dentro de las 24 horas hábiles siguientes a la entrega.',
  },
  {
    titulo: 'Cobertura nacional',
    texto:
      'En cantones, caseríos y zonas de difícil acceso, el punto de entrega se coordina directamente con el repartidor de Xpress.',
  },
];

const tarjeta = 'rounded-card border border-white/15 bg-white/6 p-7';
const eyebrow = 'mb-3.5 font-display text-xs font-bold uppercase tracking-[0.16em] text-brand';
const h2 = 'text-[clamp(28px,4.2vw,42px)] font-extrabold italic leading-[1.08] tracking-tight';
const lede = 'mt-4 max-w-[62ch] text-[clamp(17px,2.1vw,20px)] text-ink-soft';
const shell = 'mx-auto w-full max-w-[1160px] px-[22px] max-sm:px-[18px]';
const iconoCaja = 'mb-4.5 grid h-[46px] w-[46px] place-items-center rounded-2xl border border-brand/35 bg-brand/15';
const iconoSvg = 'h-[23px] w-[23px] fill-none stroke-brand stroke-[1.9] [stroke-linecap:round] [stroke-linejoin:round]';
---

<Base
  title="Urbby — Marketplace salvadoreño con pagos y envíos a todo el país"
  description="Urbby conecta compradores con comercios afiliados en El Salvador. Pagá con Urbby Pay, con tarjeta o contra entrega, y recibí con Xpress en 24 horas hábiles."
>
  {/* ===================== HERO ===================== */}
  <section class="py-[clamp(56px,9vw,104px)] max-sm:py-11">
    <div class={`${shell} grid grid-cols-[1.05fr_0.95fr] items-center gap-[clamp(32px,5vw,64px)] max-lg:grid-cols-1`}>
      <div>
        <p data-reveal class={eyebrow}>Marketplace · El Salvador</p>
        <h1 data-reveal class="text-[clamp(38px,6.4vw,66px)] font-extrabold italic leading-[1.05] tracking-tight">
          Comprá de muchos comercios, recibí en un solo lugar.
        </h1>
        <p data-reveal class="mt-[22px] max-w-[62ch] text-[clamp(17px,2.1vw,20px)] text-ink-soft">
          <strong class="text-white">Urbby</strong> es un marketplace que conecta a compradores con
          <strong class="text-white">Comercios afiliados</strong> en todo El Salvador. Pagás con
          <strong class="text-white">Urbby Pay</strong> —tarjeta o contra entrega— y
          <strong class="text-white">Xpress</strong> te lo lleva a la puerta.
        </p>
        <div data-reveal class="mt-8 flex flex-wrap gap-3.5 max-sm:flex-col">
          <a
            href="#como-comprar"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full bg-brand px-7 text-base font-bold text-navy-900 no-underline transition-colors hover:bg-brand-soft active:translate-y-px"
          >
            Cómo comprar
          </a>
          <a
            href="#envios"
            class="inline-flex min-h-[52px] items-center justify-center rounded-full border border-white/35 px-7 text-base font-bold text-white no-underline transition-colors hover:border-brand hover:bg-white/5 active:translate-y-px"
          >
            Ver cobertura y plazos
          </a>
        </div>
        <p data-reveal class="mt-5 text-sm text-ink-mute">
          Operado por {empresa.razonSocialCorta}, {empresa.ciudad}, {empresa.pais}.
        </p>
      </div>

      {/* Resumen del ecosistema */}
      <div data-reveal="card" class="rounded-card border border-white/15 bg-gradient-to-b from-white/12 to-white/5 p-7 shadow-[0_30px_60px_-28px_rgba(0,0,0,0.65)]">
        <p class="mb-5 text-[11.5px] font-bold uppercase tracking-[0.14em] text-brand">El ecosistema Urbby</p>
        <dl class="m-0 flex flex-col gap-5">
          <div class="flex gap-4">
            <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-brand/35 bg-brand/15">
              <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-brand stroke-[1.9] [stroke-linecap:round] [stroke-linejoin:round]" aria-hidden="true">
                <path d="M3 6h18l-1.6 9.2a2 2 0 0 1-2 1.8H7.6a2 2 0 0 1-2-1.8L4 6" />
                <circle cx="9" cy="20" r="1.4" /><circle cx="17" cy="20" r="1.4" />
              </svg>
            </div>
            <div>
              <dt class="text-base font-bold">Marketplace</dt>
              <dd class="m-0 text-[15px] text-ink-soft">Buscá, compará y comprá productos de distintos Comercios afiliados.</dd>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-brand/35 bg-brand/15">
              <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-brand stroke-[1.9] [stroke-linecap:round] [stroke-linejoin:round]" aria-hidden="true">
                <rect x="2.5" y="5.5" width="19" height="13" rx="2.5" /><path d="M2.5 10h19" />
              </svg>
            </div>
            <div>
              <dt class="text-base font-bold">Urbby Pay</dt>
              <dd class="m-0 text-[15px] text-ink-soft">Pagos con tarjeta procesados por Banco Agrícola, o contra entrega donde aplique.</dd>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-brand/35 bg-brand/15">
              <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-brand stroke-[1.9] [stroke-linecap:round] [stroke-linejoin:round]" aria-hidden="true">
                <path d="M2.5 7.5h11v9h-11zM13.5 11h4l3 3v2.5h-7z" />
                <circle cx="6.5" cy="18" r="1.6" /><circle cx="17" cy="18" r="1.6" />
              </svg>
            </div>
            <div>
              <dt class="text-base font-bold">Envíos con Xpress</dt>
              <dd class="m-0 text-[15px] text-ink-soft">Recolección en el Comercio y entrega a domicilio con cobertura nacional.</dd>
            </div>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {/* ===================== CÓMO COMPRAR ===================== */}
  <section id="como-comprar" class={`${shell} scroll-mt-24 py-[clamp(40px,6vw,72px)]`}>
    <p data-reveal class={eyebrow}>Cómo comprar</p>
    <h2 data-reveal class={h2}>Del carrito a tu puerta, en cuatro pasos.</h2>
    <p data-reveal class={lede}>
      Urbby es un intermediario tecnológico: los productos son de los Comercios afiliados, y nosotros
      ponemos la plataforma, el pago y la coordinación del envío.
    </p>

    <ol class="mt-9 grid list-none grid-cols-4 gap-4.5 p-0 max-lg:grid-cols-2 max-sm:grid-cols-1">
      {
        pasos.map((paso, i) => (
          <li data-reveal="card" class="rounded-tile border border-white/15 bg-white/4 p-[22px]">
            <div class="mb-2.5 font-display text-[26px] font-extrabold italic text-brand">
              {String(i + 1).padStart(2, '0')}
            </div>
            <h3 class="mb-1.5 text-[17px] font-bold not-italic">{paso.titulo}</h3>
            <p class="text-[14.5px] text-ink-soft">{paso.texto}</p>
          </li>
        ))
      }
    </ol>

    <div data-reveal="card" class="mt-5 rounded-tile border border-brand/35 bg-brand/10 p-6">
      <p class="m-0 text-[15.5px] text-white">
        <strong>Sobre el costo de envío:</strong> se calcula por zona de origen. Si tu carrito incluye
        Comercios de zonas distintas, la orden puede dividirse en varios envíos y generar más de un
        cargo. Siempre lo ves desglosado antes de confirmar.
      </p>
    </div>
  </section>

  {/* ===================== URBBY PAY ===================== */}
  <section id="pagos" class={`${shell} scroll-mt-24 py-[clamp(40px,6vw,72px)]`}>
    <p data-reveal class={eyebrow}>Urbby Pay</p>
    <h2 data-reveal class={h2}>Pagá como te quede mejor.</h2>

    <div class="mt-9 grid grid-cols-3 gap-5 max-lg:grid-cols-1">
      <div data-reveal="card" class={tarjeta}>
        <div class={iconoCaja}>
          <svg viewBox="0 0 24 24" class={iconoSvg} aria-hidden="true">
            <rect x="2.5" y="5.5" width="19" height="13" rx="2.5" /><path d="M2.5 10h19M6 14.5h4" />
          </svg>
        </div>
        <h3 class="mb-2.5 text-xl font-bold not-italic">Con tarjeta</h3>
        <p class="text-[15.5px] text-ink-soft">
          Los pagos se procesan a través de Banco Agrícola. Urbby <strong class="text-white">no
          almacena ni tiene acceso</strong> a los datos completos de tu tarjeta: únicamente recibe un
          token por cada transacción.
        </p>
      </div>

      <div data-reveal="card" class={tarjeta}>
        <div class={iconoCaja}>
          <svg viewBox="0 0 24 24" class={iconoSvg} aria-hidden="true">
            <path d="M12 3.5v17M8 7h6.5a2.75 2.75 0 0 1 0 5.5h-5a2.75 2.75 0 0 0 0 5.5H16" />
          </svg>
        </div>
        <h3 class="mb-2.5 text-xl font-bold not-italic">Contra entrega</h3>
        <p class="text-[15.5px] text-ink-soft">
          Según el Comercio y la zona, podés pagar al recibir. El cobro lo hace el personal de Xpress
          al momento de la entrega, en efectivo o con terminal de tarjeta.
        </p>
      </div>

      <div data-reveal="card" class={tarjeta}>
        <div class={iconoCaja}>
          <svg viewBox="0 0 24 24" class={iconoSvg} aria-hidden="true">
            <path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1" /><path d="M20.5 4v4.5H16" />
          </svg>
        </div>
        <h3 class="mb-2.5 text-xl font-bold not-italic">Reembolsos</h3>
        <p class="text-[15.5px] text-ink-soft">
          Si te corresponde un reembolso, lo gestionamos una vez recibidos los fondos de Xpress o del
          Comercio. El proceso puede tomar algunos días hábiles mientras se completa esa gestión.
        </p>
      </div>
    </div>

    <p data-reveal class="mt-5 max-w-[80ch] text-sm text-ink-mute">
      Los precios se muestran en dólares de los Estados Unidos de América e incluyen los impuestos
      aplicables, salvo que se indique lo contrario. El costo de envío se calcula y se muestra por
      separado antes de confirmar la compra.
    </p>
  </section>

  {/* ===================== ENVÍOS ===================== */}
  <section id="envios" class={`${shell} scroll-mt-24 py-[clamp(40px,6vw,72px)]`}>
    <p data-reveal class={eyebrow}>Envíos con Xpress</p>
    <h2 data-reveal class={h2}>Plazos, intentos y cobertura, sin letra chica.</h2>

    <div class="mt-9 grid grid-cols-2 gap-5 max-lg:grid-cols-1">
      {
        envios.map((e) => (
          <div data-reveal="card" class={tarjeta}>
            <h3 class="mb-2.5 text-xl font-bold not-italic">{e.titulo}</h3>
            <p class="text-[15.5px] text-ink-soft">{e.texto}</p>
          </div>
        ))
      }
    </div>

    <div data-reveal="card" class="mt-5 rounded-tile border border-white/15 bg-white/4 p-6">
      <h3 class="mb-2.5 text-[17px] font-bold not-italic">Qué no cubre el seguro</h3>
      <p class="m-0 text-[15px] text-ink-soft">
        Los productos de vidrio, espejos, porcelanas, cerámicas, muebles con vidrio o melamina,
        artesanías de barro, plantas naturales y productos perecederos se envían bajo responsabilidad
        exclusiva del Comercio remitente y no cuentan con cobertura de seguro de Xpress. El embalaje
        siempre es responsabilidad del Comercio vendedor.
      </p>
      <p class="mt-3 mb-0 text-[15px] text-ink-soft">
        Tampoco se aceptan envíos de dinero en efectivo, materiales peligrosos, piedras preciosas,
        artículos de oro, títulos negociables, animales ni cheques de caja o gerencia.
      </p>
    </div>
  </section>

  {/* ===================== TUS DERECHOS ===================== */}
  <section id="derechos" class={`${shell} scroll-mt-24 py-[clamp(40px,6vw,72px)]`}>
    <p data-reveal class={eyebrow}>Tus derechos</p>
    <h2 data-reveal class={h2}>Comprás protegido.</h2>

    <div class="mt-9 grid grid-cols-3 gap-5 max-lg:grid-cols-1">
      <div data-reveal="card" class={tarjeta}>
        <h3 class="mb-2.5 text-xl font-bold not-italic">Protección al consumidor</h3>
        <p class="text-[15.5px] text-ink-soft">
          Conservás todos los derechos que te reconoce la Ley de Protección al Consumidor de El
          Salvador: información veraz sobre el producto y su precio, trato equitativo y no
          discriminatorio, y la posibilidad de reclamar ante la Defensoría del Consumidor.
        </p>
      </div>

      <div data-reveal="card" class={tarjeta}>
        <h3 class="mb-2.5 text-xl font-bold not-italic">Cancelaciones y devoluciones</h3>
        <p class="text-[15.5px] text-ink-soft">
          Podés cancelar una orden antes de que el Comercio la despache. Después, se gestiona como
          devolución o cambio según la política del Comercio, que está publicada en su perfil dentro
          de la plataforma.
        </p>
      </div>

      <div data-reveal="card" class={tarjeta}>
        <h3 class="mb-2.5 text-xl font-bold not-italic">Tus datos personales</h3>
        <p class="text-[15.5px] text-ink-soft">
          Tratamos tus datos conforme a la Ley para la Protección de Datos Personales (Decreto
          Legislativo N.º 144). Podés ejercer tus derechos ARCO-POL cuando quieras, y
          <strong class="text-white"> no vendemos ni comercializamos</strong> tus datos.
        </p>
      </div>
    </div>

    <p data-reveal class="mt-6 max-w-[84ch] text-[15.5px] text-ink-soft">
      Los reclamos sobre calidad, garantía o características del producto se dirigen primero al
      Comercio vendedor, por los canales de su perfil. Los reclamos sobre el pago o el envío podés
      dirigirlos directamente a Urbby. Leé el detalle en los
      {' '}<a href="/terminos" class="font-semibold">Términos y Condiciones</a> y en la
      {' '}<a href="/privacidad" class="font-semibold">Declaración de Privacidad</a>.
    </p>
  </section>

  {/* ===================== CONTACTO ===================== */}
  <section id="contacto" class={`${shell} scroll-mt-24 py-[clamp(40px,6vw,72px)]`}>
    <p data-reveal class={eyebrow}>Contacto</p>
    <h2 data-reveal class={h2}>Estamos acá para ayudarte.</h2>
    <p data-reveal class={lede}>
      Para reclamos sobre el pago o el envío, escribinos directamente. Para temas del producto,
      contactá primero al Comercio vendedor desde su perfil.
    </p>

    <div class="mt-9 grid grid-cols-3 gap-5 max-lg:grid-cols-1">
      <div data-reveal="card" class="rounded-tile border border-white/15 bg-white/4 p-6">
        <p class="mb-2.5 text-[11.5px] font-bold uppercase tracking-[0.14em] text-brand">Correo electrónico</p>
        <p class="break-words text-base font-semibold">
          <a href={`mailto:${empresa.correo}`} class="border-b border-brand/55 text-white no-underline hover:text-brand">
            {empresa.correo}
          </a>
        </p>
        <p class="mt-2 text-[13.5px] font-normal text-ink-mute">
          Soporte, reclamos y derechos ARCO-POL.
        </p>
      </div>

      <div data-reveal="card" class="rounded-tile border border-white/15 bg-white/4 p-6">
        <p class="mb-2.5 text-[11.5px] font-bold uppercase tracking-[0.14em] text-brand">Teléfono</p>
        <p class="break-words text-base font-semibold">
          <a href={`tel:${empresa.telefonoEnlace}`} class="border-b border-brand/55 text-white no-underline hover:text-brand">
            {empresa.telefono}
          </a>
        </p>
        <p class="mt-2 text-[13.5px] font-normal text-ink-mute">
          Atención de lunes a sábado, en horario hábil.
        </p>
      </div>

      <div data-reveal="card" class="rounded-tile border border-white/15 bg-white/4 p-6">
        <p class="mb-2.5 text-[11.5px] font-bold uppercase tracking-[0.14em] text-brand">Dirección física</p>
        <p class="text-base font-semibold leading-relaxed">
          {empresa.direccion},<br />{empresa.pais}
        </p>
        <p class="mt-2 text-[13.5px] font-normal text-ink-mute">
          Domicilio registrado de {empresa.razonSocialCorta}
        </p>
      </div>
    </div>
  </section>
</Base>
