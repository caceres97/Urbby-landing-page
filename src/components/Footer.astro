---
import { empresa } from '../data/empresa';
---

<footer class="mt-[clamp(56px,8vw,96px)] border-t border-white/15 pt-12 pb-10">
  <div class="mx-auto w-full max-w-[1160px] px-[22px] max-sm:px-[18px]">
    <div class="grid grid-cols-[1.6fr_1fr_1fr] gap-[34px] max-lg:grid-cols-2 max-sm:grid-cols-1">
      <div data-reveal>
        <a href="/" class="mb-4 inline-block no-underline" aria-label="Urbby, inicio">
          <img src="/assets/Urbby_SFY.png" alt="Urbby" width="106" height="30" class="block h-[30px] w-auto" />
        </a>
        <p class="mb-4 text-[14.5px] text-ink-soft">
          Marketplace salvadoreño. Comercios afiliados, pagos con Urbby Pay y entregas con Xpress.
        </p>
        <p class="mb-1.5 text-[14.5px] font-bold text-white">{empresa.razonSocial}</p>
        <p class="mb-1.5 text-[14.5px] leading-relaxed text-ink-mute">{empresa.direccion}</p>
        <p class="mb-1.5 text-[14.5px] text-ink-mute">{empresa.pais}</p>
        <p class="mb-1.5 text-[14.5px] text-ink-mute">NIT / NRC: {empresa.nit} · {empresa.nrc}</p>
        <p class="mb-1.5 text-[14.5px]">
          <a href={`mailto:${empresa.correo}`} class="text-ink-soft no-underline hover:text-white">{empresa.correo}</a>
        </p>
        <p class="text-[14.5px]">
          <a href={`tel:${empresa.telefonoEnlace}`} class="text-ink-soft no-underline hover:text-white">{empresa.telefono}</a>
        </p>
      </div>

      <div data-reveal>
        <h4 class="mb-3.5 font-display text-xs font-bold uppercase tracking-[0.14em] text-brand">Comprar</h4>
        <ul class="m-0 list-none p-0">
          <li class="mb-2.5"><a href="/#como-comprar" class="text-[14.5px] text-ink-soft no-underline hover:text-white">Cómo comprar</a></li>
          <li class="mb-2.5"><a href="/#pagos" class="text-[14.5px] text-ink-soft no-underline hover:text-white">Urbby Pay</a></li>
          <li class="mb-2.5"><a href="/#envios" class="text-[14.5px] text-ink-soft no-underline hover:text-white">Envíos con Xpress</a></li>
          <li><a href="/contacto" class="text-[14.5px] text-ink-soft no-underline hover:text-white">Contacto</a></li>
        </ul>
      </div>

      <div data-reveal>
        <h4 class="mb-3.5 font-display text-xs font-bold uppercase tracking-[0.14em] text-brand">Legal</h4>
        <ul class="m-0 list-none p-0">
          <li class="mb-2.5"><a href="/terminos" class="text-[14.5px] text-ink-soft no-underline hover:text-white">Términos y Condiciones</a></li>
          <li class="mb-2.5"><a href="/privacidad" class="text-[14.5px] text-ink-soft no-underline hover:text-white">Declaración de Privacidad</a></li>
          <li><a href="/eliminar-datos" class="text-[14.5px] text-ink-soft no-underline hover:text-white">Eliminación de datos</a></li>
        </ul>
      </div>
    </div>

    <div
      data-reveal
      class="mt-9 flex flex-wrap items-center gap-x-[22px] gap-y-2.5 border-t border-white/15 pt-[22px] text-[13.5px] text-ink-mute"
    >
      <span>© 2026 {empresa.razonSocial}. Todos los derechos reservados.</span>
      <span class="ml-auto max-w-[62ch] text-right max-sm:ml-0 max-sm:text-left">
        Urbby actúa como intermediario tecnológico entre Comercios afiliados y compradores;
        los productos son responsabilidad de cada Comercio vendedor.
      </span>
    </div>
  </div>
</footer>
