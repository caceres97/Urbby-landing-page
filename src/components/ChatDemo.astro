---
/** Conversación animada: el cliente escribe, Urbby Bot responde y cierra el pedido. */
const mensajes = [
  { bot: false, texto: 'Hola, ¿tienen disponible el producto que vi en su catálogo?' },
  {
    bot: true,
    texto:
      '¡Hola! Sí, está disponible con un comercio afiliado. Te comparto precio, opciones y tiempo de entrega a tu zona.',
  },
  { bot: false, texto: 'Perfecto, ¿hacen envío a Santa Ana?' },
  {
    bot: true,
    texto:
      'Sí, con Xpress. Te armo el resumen del pedido con el total y el costo de envío para que lo confirmés y pagués con Urbby Pay.',
  },
  { bot: false, texto: 'Dale, confirmalo.' },
  {
    bot: true,
    texto:
      'Listo, tu pedido quedó confirmado. Te llega con Xpress en 24–48 horas y te enviamos el comprobante por este mismo chat.',
  },
];
---

<div
  data-reveal="card"
  class="rounded-card border border-white/15 bg-gradient-to-b from-white/12 to-white/5 p-[22px] shadow-[0_30px_60px_-28px_rgba(0,0,0,0.65)]"
  role="img"
  aria-label="Ejemplo de conversación: un cliente pregunta por un producto en WhatsApp, Urbby Bot responde automáticamente, arma el pedido y lo confirma."
>
  <div class="flex items-center gap-[11px] border-b border-white/15 pb-4">
    <div class="grid h-10 w-10 place-items-center rounded-xl bg-brand font-display text-xl font-extrabold italic text-navy-900">
      Ü
    </div>
    <div>
      <div class="text-[15px] font-bold leading-tight">Urbby Bot</div>
      <div data-chat-state class="text-[12.5px] leading-tight text-ink-mute transition-colors">
        En línea · responde en segundos
      </div>
    </div>
  </div>

  <div data-chat-log aria-hidden="true" class="chat-log flex flex-col justify-end gap-3 overflow-hidden pt-[18px]">
    {
      mensajes.map((m) => (
        <div
          class:list={[
            'max-w-[86%] rounded-2xl px-4 py-3 text-[15px] leading-normal max-sm:max-w-[92%] max-sm:text-[14.5px]',
            m.bot
              ? 'self-end rounded-br-[5px] bg-brand font-semibold text-navy-900'
              : 'self-start rounded-bl-[5px] bg-white/10',
          ]}
        >
          {m.texto}
          <span
            class:list={[
              'mt-[7px] block text-[11px] font-bold uppercase tracking-[0.09em]',
              m.bot ? 'text-brand-ink' : 'text-ink-mute',
            ]}
          >
            {m.bot ? 'Urbby Bot · Automático' : 'Cliente · WhatsApp'}
          </span>
        </div>
      ))
    }
  </div>
</div>

<script>
  /* Escribe la conversación en bucle. Si no hay JS o el usuario pidió menos
     movimiento, los mensajes quedan visibles tal cual los renderiza Astro. */
  const log = document.querySelector<HTMLElement>('[data-chat-log]');
  const state = document.querySelector<HTMLElement>('[data-chat-state]');

  if (log && state && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const items = Array.from(log.children) as HTMLElement[];

    const IDLE = 'En línea · responde en segundos';
    const TYPING = 'escribiendo…';

    const typing = document.createElement('div');
    typing.className =
      'self-end flex items-center gap-1.5 rounded-2xl rounded-br-[5px] bg-brand px-[18px] py-4 bubble-in';
    typing.innerHTML =
      '<span class="typing-dot h-[7px] w-[7px] rounded-full bg-navy-900"></span>'.repeat(3);

    let timers: number[] = [];
    let index = 0;
    let running = false;

    const later = (fn: () => void, ms: number) => timers.push(window.setTimeout(fn, ms));
    const clearTimers = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const detachTyping = () => typing.parentNode?.removeChild(typing);

    const setIdle = () => {
      state.textContent = IDLE;
      state.classList.remove('text-brand');
      state.classList.add('text-ink-mute');
    };

    const setTyping = () => {
      state.textContent = TYPING;
      state.classList.remove('text-ink-mute');
      state.classList.add('text-brand');
    };

    const hideAll = () => {
      detachTyping();
      setIdle();
      for (const el of items) {
        el.hidden = true;
        el.classList.remove('bubble-in');
      }
    };

    /* Al pausar dejamos la conversación completa a la vista, nunca vacía. */
    const showAll = () => {
      detachTyping();
      setIdle();
      for (const el of items) {
        el.hidden = false;
        el.classList.remove('bubble-in');
      }
    };

    const reveal = (el: HTMLElement) => {
      el.hidden = false;
      void el.offsetWidth; /* reinicia la animación al reiniciar el ciclo */
      el.classList.add('bubble-in');
      index++;
      later(step, 620);
    };

    function step() {
      if (index >= items.length) {
        later(restart, 4600);
        return;
      }
      const el = items[index];
      const esBot = el.classList.contains('self-end');

      if (esBot) {
        setTyping();
        log!.appendChild(typing);
        later(() => {
          detachTyping();
          setIdle();
          reveal(el);
        }, 1250);
      } else {
        later(() => reveal(el), 780);
      }
    }

    function restart() {
      clearTimers();
      hideAll();
      index = 0;
      later(step, 600);
    }

    const start = () => {
      if (running) return;
      running = true;
      hideAll();
      later(step, 500);
    };

    /* Arranca cuando la tarjeta entra en pantalla. El temporizador de respaldo
       garantiza que nunca quede una tarjeta vacía si el observer no dispara. */
    hideAll();
    later(start, 2200);

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            io.disconnect();
            start();
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      io.observe(log);
    }

    document.addEventListener('visibilitychange', () => {
      if (!running) return;
      if (document.hidden) {
        clearTimers();
        showAll();
      } else {
        restart();
      }
    });
  }
</script>
