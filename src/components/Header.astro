---
const { pathname } = Astro.url;

const nav = [
  { href: '/#como-comprar', label: 'Cómo comprar' },
  { href: '/#pagos', label: 'Urbby Pay' },
  { href: '/#envios', label: 'Envíos' },
  { href: '/contacto', label: 'Contacto' },
  { href: '/terminos', label: 'Términos' },
  { href: '/privacidad', label: 'Privacidad' },
];

const esPagina = (href: string) =>
  !href.includes('#') && pathname.replace(/\/$/, '') === href.replace(/\/$/, '');
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-white/15 bg-navy-900/70 backdrop-blur-lg transition-[background-color,box-shadow] duration-250"
>
  <div class="mx-auto flex min-h-[74px] w-full max-w-[1160px] items-center gap-5 px-[22px] max-sm:min-h-16 max-sm:px-[18px]">
    <a href="/" class="flex items-center no-underline" aria-label="Urbby, inicio">
      <img src="/assets/Urbby_SFY.png" alt="Urbby" width="120" height="34" class="block h-[34px] w-auto max-sm:h-[29px]" />
    </a>

    <nav class="ml-auto flex items-center gap-6 max-lg:hidden" aria-label="Navegación principal">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={esPagina(item.href) ? 'page' : undefined}
          class:list={[
            'border-b-2 py-1.5 text-[15px] font-semibold no-underline transition-colors hover:border-brand hover:text-white',
            esPagina(item.href) ? 'border-brand text-white' : 'border-transparent text-ink-soft',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      href="/contacto"
      class="ml-auto hidden rounded-full bg-brand px-5 py-2.5 text-sm font-bold text-navy-900 no-underline max-lg:inline-flex"
    >
      Contacto
    </a>
  </div>

  <div
    data-progress
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-px left-0 right-0 h-0.5 origin-left bg-brand opacity-90 motion-reduce:hidden"
    style="transform: scaleX(var(--sp, 0));"
  >
  </div>
</header>
